# Database Neon PostgreSQL (gunakan pooled connection string dari dashboard Neon)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret key minimal 32 karakter untuk signing JWT cookie sesi Admin (openssl rand -hex 32)
AUTH_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

# API Key AI SDK untuk Smart Document Extractor (Google Gemini API key atau OpenAI API key)
# Google Gemini: AIza... | OpenAI: sk-...
AI_API_KEY=""
# Opsional: "auto" | "gemini" | "openai"
AI_PROVIDER="auto"

# Token Vercel Blob untuk menyimpan dokumen resmi PDF/Excel di cloud (wajib di Vercel)
BLOB_READ_WRITE_TOKEN=""
